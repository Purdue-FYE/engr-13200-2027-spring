from myst_nb import glue
import pathlib

def normalize_extension(ext: str) -> str:
  """Normalize deliverable extensions from frontmatter.

  Accept shorthand values like "m" and normalize to a dot-prefixed extension.
  """
  ext = ext.strip().lower()
  if not ext:
    raise ValueError("Deliverable extension cannot be empty")
  if not ext.startswith("."):
    ext = f".{ext}"
  return ext

def build_deliverable_filename(label: str, ext: str) -> str:
  """Build a deliverable filename using username-first convention."""
  return f"username_{label}{normalize_extension(ext)}"

